
pipeline {
    agent any

    stages {
        stage('Test') {
            steps {
                echo 'Jenkins is working!'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t jenkins-docker-app .'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@13.232.154.142 "sudo docker pull nginx:latest"
                    '''
                }
            }
        }
    }
}
